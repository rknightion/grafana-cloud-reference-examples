{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "always-update": true,
  "packages": {
    "common/nodejs": {
      "component": "common-nodejs",
      "release-type": "node",
      "extra-files": [
        {
          "type": "json",
          "path": "/package-lock.json",
          "jsonpath": "$.packages['common/nodejs'].version"
        }
      ]
    },
    "common/python": {
      "component": "common-python",
      "release-type": "python",
      "extra-files": [
        "pyproject.toml",
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='grafana-cloud-common')].version"
        }
      ]
    },
    "examples/adobe-aem": {
      "component": "adobe-aem",
      "release-type": "python",
      "extra-files": [
        "pyproject.toml",
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='grafana-cloud-example-adobe-aem')].version"
        }
      ]
    },
    "examples/docdb-connection-attribution": {
      "component": "docdb-connection-attribution",
      "release-type": "python",
      "extra-files": [
        "pyproject.toml",
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='grafana-cloud-example-docdb-connection-attribution')].version"
        }
      ]
    },
    "examples/generic-s3": {
      "component": "generic-s3",
      "release-type": "python",
      "extra-files": [
        "pyproject.toml",
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='grafana-cloud-example-generic-s3')].version"
        }
      ]
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "deps",
      "section": "Dependencies"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "refactor",
      "section": "Refactoring",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    }
  ]
}

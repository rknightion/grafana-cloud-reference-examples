{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "packages": {
    "common/python": {
      "component": "common-python",
      "release-type": "python",
      "extra-files": ["pyproject.toml"]
    },
    "common/nodejs": {
      "component": "common-nodejs",
      "release-type": "node"
    },
    "examples/adobe-aem": {
      "component": "adobe-aem",
      "release-type": "python",
      "extra-files": ["pyproject.toml"]
    },
    "examples/generic-s3": {
      "component": "generic-s3",
      "release-type": "python",
      "extra-files": ["pyproject.toml"]
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "deps",
      "section": "Dependencies"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "refactor",
      "section": "Refactoring",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    }
  ]
}
